{
  "name": "a11y-control",
  "version": "1.1.1",
  "description": "A plug-and-play accessibility toolbar and assistive aid for the web, WCAG 2.1 AA/AAA compliant, built as a native Web Component.",
  "type": "module",
  "main": "src/a11y-control.js",
  "types": "src/a11y-control.d.ts",
  "unpkg": "src/a11y-control.js",
  "jsdelivr": "src/a11y-control.js",
  "exports": {
    ".": {
      "types": "./src/a11y-control.d.ts",
      "import": "./src/a11y-control.js",
      "default": "./src/a11y-control.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "_agent",
    "llms.txt"
  ],
  "scripts": {
    "dev": "npx serve . --listen 3131"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinMerle/a11y-control.git"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "web-component",
    "a11y",
    "menu",
    "dark-mode"
  ],
  "author": "Quentin Merle",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.0.0"
  }
}