{
  "name": "a11y-control",
  "version": "1.2.3",
  "description": "A zero-dependency native Web Component accessibility preferences toolbar & assistive companion, built to W3C APG and WCAG 2.1/2.2 standards. The lightweight, privacy-first open-source alternative to UserWay & accessiBe.",
  "type": "module",
  "main": "src/a11y-control.js",
  "types": "src/a11y-control.d.ts",
  "unpkg": "src/a11y-control.js",
  "jsdelivr": "src/a11y-control.js",
  "exports": {
    ".": {
      "types": "./src/a11y-control.d.ts",
      "import": "./src/a11y-control.js",
      "default": "./src/a11y-control.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "_agent",
    "llms.txt"
  ],
  "scripts": {
    "test": "node test/audit.js && for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "dev": "npx serve . --listen 3131"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinMerle/a11y-control.git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "web-component",
    "custom-elements",
    "wcag",
    "wcag-aaa",
    "wcag-2-1",
    "wcag-2-2",
    "eaa-2025",
    "european-accessibility-act",
    "rgaa",
    "ada-compliance",
    "section-508",
    "accessibility-toolbar",
    "assistive-technology",
    "text-to-speech",
    "speech-synthesis",
    "dyslexia-font",
    "text-spacing",
    "dark-mode",
    "zero-dependencies",
    "framework-agnostic",
    "userway-alternative",
    "accessibe-alternative",
    "agent-ready"
  ],
  "author": "Quentin Merle",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.0.0"
  }
}